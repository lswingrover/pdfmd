#!/usr/bin/env bash
# post-commit: auto-publish the current branch to origin ("remote control").
#
# Part of the "1 branch = 1 worktree = 1 session" model: every unit of work is backed
# up to its own origin/<branch> the moment it is committed, so nothing sits stranded
# in a local worktree where a deleted directory or a dead disk would take it.
#
# Scope: feature/session branches are pushed to origin/<branch>. Trunk branches
# (main, master, staging, dev) are never published by this hook; they are mirrored to
# refs/backup/<branch> instead (see below). main is also covered by the pre-push guard.
#
# NON-BLOCKING, BUT NEVER SILENT ON FAILURE. The push runs in the background so the
# commit returns immediately; a hook must not make you wait on the network. A failed
# push is not discarded, though: stranded work looks exactly like pushed work, so a
# push failure that leaves no trace goes unnoticed until someone asks git directly.
# On failure the hook writes a per-repo marker plus a line in a shared log; a later
# successful push removes the marker, so it cannot go stale and cry wolf. Success is
# completely silent.
#
# Read failures with:  cat ~/.claude/push-failures/*.log
#
# Install with: bash scripts/install-git-hooks.sh
_pushfail_dir="$HOME/.claude/push-failures"

_push_and_record() {   # $1 = refspec/branch args, $2 = human label
  (
    if err=$(git push $1 2>&1); then
      rm -f "$_pushfail_dir/$_slug" 2>/dev/null
    else
      mkdir -p "$_pushfail_dir" 2>/dev/null
      printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" "$2" \
        "$(printf '%s' "$err" | tr '\n' ' ' | cut -c1-300)" >> "$_pushfail_dir/$_slug"
      printf '%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$PWD" "$2" \
        >> "$_pushfail_dir/all.log"
    fi
  ) >/dev/null 2>&1 &
}

_slug="$(printf '%s' "$PWD" | tr '/' '_' | sed 's/^_//').log"

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
[ -z "$branch" ] && exit 0
case "$branch" in
  main | master | staging | dev)
    # TRUNK COMMITS STILL GET AN OFF-MACHINE COPY, just not by publishing the trunk.
    #
    # A trunk should be pushed deliberately, not by a hook. But skipping trunks
    # entirely leaves work committed directly to a trunk (typically in a shared
    # checkout, where the risk is highest) with no backup at all.
    #
    # So mirror the trunk to refs/backup/<branch> instead. That is a real off-machine
    # copy; it does NOT move origin/<trunk>, does not open a PR or trigger CI, and
    # cannot trip pre-push.d/10-main-guard (which matches on the DESTINATION ref
    # refs/heads/main, not on what is being pushed). Force-updated because it is a
    # mirror of local state, not a branch anyone builds on.
    #
    # Recover with:  git fetch origin refs/backup/<branch>:refs/heads/rescue-<branch>
    _push_and_record "-f origin HEAD:refs/backup/$branch" "trunk-backup:$branch"
    exit 0 ;;
esac

# Feature branch: background push; a failure is recorded as described above.
_push_and_record "-u origin $branch" "feature-branch:$branch"
exit 0
